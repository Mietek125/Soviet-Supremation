export function PrepareBase(side, nation, area, skill, w, l, a, e);
var i, j, btype, t, h;
begin

     uc_side = side;
     uc_nation = nation;

     for i in FilterUnitsInArea(area, [[f_side, side], [f_type, unit_building], [f_not, [f_btype, b_control_tower]] ]) do
     begin
       btype := 0;
         case GetBType(i) of
                   b_depot, b_warehouse: btype := 1;
                   b_armoury, b_barracks: btype := 2;
                   b_lab, b_lab_half, b_lab_full: btype := 3;
                   b_workshop, b_factory: btype := 4;
                   b_breastwork, b_bunker: btype := 5;
                   end;

                   t := [e, a, l, w, 1][btype];
                            for j = 1 to t do
                                begin
                                     InitHc;
                                     Case btype of
                                     1:PrepareEngineer(Rand(1, 2), skill);
                                     2:PrepareSoldier(Rand(1, 2), skill);
                                     3:PrepareScientist(Rand(1, 2), skill);
                                     4:PrepareMechanic(Rand(1, 2), skill);
                                     5:PrepareSoldier(Rand(1, 2), skill);
                                     end;
                                     h = CreateHuman;
                                     if btype = 1 then PlaceUnitXY(h, ShiftX(GetX(i), GetDir(i), Rand(3, 6)), ShiftY(GetY(i), GetDir(i), Rand(3, 6)), false)
                                     else
                                     PlaceHumanInUnit(h, i);
                                end;
     end;

end;

Export Function Count(array);
begin
result := array + 0;
End;

Export Function IsEmpty(building);
begin
if not building then
   exit;

result := building in FilterAllUnits([[f_side, GetSide(building)], [f_empty]]);
End;

Export Function IsNotFull(building);
var places;
begin
if not building then
   exit;

result := UnitFilter(building, [f_not, [f_full]]);
End;

