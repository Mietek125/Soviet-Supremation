{ King of the Hill }
Export kingOfTheHillScores;
Export function InitKingOfTheHill;
begin
kingOfTheHillScores := [0, 0, 0, 0, 0, 0, 0, 0];
SetAreaMapShow(kingHillArea, true);
Enable(100);
End;

Every 0$1 trigger Game_Type = 3 do
var un, filter, output, side, newScore;
begin
enable;

filter := FilterUnitsInArea(kingHillArea, [[f_or, [f_btype, b_depot], [f_btype, b_warehouse]], [f_ready]]);

if filter then
   for un in filter do
       begin
       newScore := kingOfTheHillScores[GetSide(un)]+1;
       kingOfTheHillScores := Replace(kingOfTheHillScores, GetSide(un), newScore);
       end;

if not def_public_score then
   begin
   output := [];

   for side := 1 to Side_Positions do
       if Side_Positions[side] then
          output := output ^ (mp_sides_players_names[side] & ': ' & kingOfTheHillScores[side] & '/ ' & amount_score);

   ExtraStrings := output;
   end
else
   ExtraStrings := ['#KingoftheHill-Private', your_side, kingOfTheHillScores[your_side], amount_score];
End;

Every 0$1 trigger Game_Type = 3 marked 100 do // King of the Hill
var side;
begin
enable;

for side := 1 to Side_Positions do
    if Side_Positions[side] then
        if kingOfTheHillScores[side] >= amount_score then
           begin
           ShowWinner;
           exit;
           end;
End;

Function ShowWinner; // auxiliary function for King of the Hill
var i;
begin
if kingOfTheHillScores[your_side] >= amount_score then
   begin
   wait(0$3);
   YouWinInMultiplayer;
   exit;
   end;

wait(0$3);
YouLostInMultiplayer;
End;
