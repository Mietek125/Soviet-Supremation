function prepare_prisoners(def,area);
  var d,un;
  begin
    result:=[];

    uc_side=pris;
    uc_nation=nation_american;

    hc_name='';
    hc_importance=0;
    for d in def do
      begin
        hc_class=d[1];
        hc_sex=d[2];
        hc_attr=d[3];
        hc_basic_skills=d[4];
        hc_skills=d[5];
        un:=CreateHuman;
        PlaceUnitArea(un,area,false);
        result:=result^un;
      end;
    ComHold(result);
  end;

function prepare_yours(def,area,leadx,leady);
  var d,un,lead;
  begin
    result:=[];

    uc_side=you;
    uc_nation=nation_american;

    hc_name='';

    lead=true;

    for d in def do
      begin
        if lead then
          begin
            hc_importance=101;
            hc_name='Lisa';
            hc_gallery='us';
            hc_face_number=3;
          end
        else
          Begin
            hc_importance=0;
            hc_name='';
            hc_gallery='';
          end;

        hc_class=d[1];
        hc_sex=d[2];
        hc_attr=d[3];
        hc_basic_skills=d[4];
        hc_skills=d[5];
        un:=CreateHuman;
        if lead then
        begin
          PlaceUnitXY(un,leadx,leady,false);
          Lisa=un;
        end
        else
          PlaceUnitArea(un,area,false);

        result:=result^un;
        lead:=false;
      end;
  end;

function prepare_rus_guard(def,area);
  var d,un;
  begin
    result:=[];

    uc_side=rus;
    uc_nation=nation_russian;

    hc_name='';
    hc_importance=0;
    for d in def do
      begin
        PrepareHuman(0,d[1],d[2]);
        un:=CreateHuman;
        PlaceUnitArea(un,area,false);
        result:=result^un;
      end;
  end;

function prepare_rus_fort(def,fort);
  var d,un,i,f;
  begin
    result:=[];

    uc_side=rus;
    uc_nation=nation_russian;

    hc_name='';
    hc_importance=0;
    i:=0;
    for d in def do
      begin
        PrepareHuman(Rand(1,2),d[1],d[2]);
        un:=CreateHuman;
        i:=i+1;
        f:=fort[i];
        PlaceUnitXY(un,ShiftX(GetX(f),GetDir(f),2),ShiftY(GetY(f),GetDir(f),2),false);
        ComEnterUnit(un,f);
        result:=result^un;
      end;
  end;

