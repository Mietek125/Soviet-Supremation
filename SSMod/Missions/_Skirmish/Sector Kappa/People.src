      [class_mechanic,sex_female,[10,10],[0,2,0,0],[3,5,3,3]] ];


    def_guard1=[
      [class_soldier,4+upg],
      [class_soldier,3+upg],
      [class_soldier,3+upg] ];

    def_fort2=[
      [class_soldier,1+upg],
      [class_soldier,1+upg] ];

    def_fort3=[
      [class_mechanic,4+upg],
      [class_mechanic,4+upg] ];

    def_fort4=[
