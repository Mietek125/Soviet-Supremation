export
  you,pris,rus,ar,Player_Side;

export
  all_your,
  all_pris,

  charges1,charges2,
  sol1,sol2,

  def_your,
  def_pris1,def_pris2,def_pris3,def_pris4,def_pris5,def_pris6,
