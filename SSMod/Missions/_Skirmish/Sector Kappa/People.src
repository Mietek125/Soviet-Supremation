    for d in def do
      begin
        PrepareHuman(Rand(1,2),d[1],d[2]);
        un:=CreateHuman;
        i:=i+1;
        f:=fort[i];
        PlaceUnitXY(un,ShiftX(GetX(f),GetDir(f),2),ShiftY(GetY(f),GetDir(f),2),false);
        ComEnterUnit(un,f);
        result:=result^un;
      end;
  end;



export function prepare_people;
  var i,b;
  begin
    define_people;
    all_your:=prepare_yours(def_your,ArStart,9,7);

    all_pris:=all_pris^
      prepare_prisoners(def_pris1,ArPris1)^
      prepare_prisoners(def_pris2,ArPris2)^
      prepare_prisoners(def_pris3,ArPris3)^
      prepare_prisoners(def_pris4,ArPris4)^
      prepare_prisoners(def_pris5,ArPris5)^
      prepare_prisoners(def_pris6,ArPris6);

    prepare_rus_guard(def_guard1,ArGuard1);
    prepare_rus_fort(def_fort2,[br2_1,br2_2]);
    prepare_ar_fort(def_fort3,[veh3_1,veh3_2]);
    prepare_rus_fort(def_fort4,[br4_1,br4_2,br4_3]);
    prepare_ar_fort(def_fort5,[br5_1,br5_2,br5_3]);
    prepare_ar_guard(def_eng5,ArGuard5Eng);
    prepare_ar_guard(def_sci5,ArGuard5Sci);
    sol1:=prepare_ar_guard(def_sol51,ArGuard5Start1);
    sol2:=prepare_ar_guard(def_sol52,ArGuard5Start2);
    prepare_ar_fort(def_fort6,[br6_1,br6_2,br6_3,br6_4,br6_5,br6_6]);

    ComRemember(Sol1^Sol2);
    for i:=1 to 3 do
      begin
        AddComPlaceRemoteCharge(sol1[i],charges1[i][1],charges1[i][2],0);
        AddComMoveToArea(sol1[i],ArGuard5Sol1);
      end;
    for i:=1 to 3 do
      begin
        AddComPlaceRemoteCharge(sol2[i],charges2[i][1],charges2[i][2],0);
        AddComMoveToArea(sol2[i],ArGuard5Sol2);
      end;

    b=FilterAllUnits([f_type,unit_building]);
    for i in b do
      SetBLevel(i,GetBLevel(i) + upg);
  end;
