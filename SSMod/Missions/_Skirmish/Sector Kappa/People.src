export function prepare_sides;
var k;
begin
    you=Player_Side;
    pris=4;
    rus=3;
    ar=2;

    if you = 4 then
      pris = 1
    else if you = 3 then
      begin
        SetSide(FilterAllUnits([f_side,rus]),6);
        rus = 6;
      end
    else if you = 2 then
      begin
        SetSide(FilterAllUnits([f_side,ar]),5);
        ar = 5;
      end;

    For k=1 to 72 do
    begin
      SetTech(k,rus,state_researched);
      SetTech(k,ar,state_researched);
    end;

    SetAttitude(you,pris,att_friend,true);
    SetAttitude(you,rus,att_enemy,true);
    SetAttitude(you,ar,att_enemy,true);
    SetAttitude(rus,ar,att_friend,true);
    SetAttitude(rus,pris,att_friend,true);
    SetAttitude(ar,pris,att_friend,true);

    ChangeSideFog(pris,you);
    RevealFogArea(you,AllMap);

    charges1=[[78,39],[79,42],[81,42]];
    charges2=[[79,36],[80,38],[81,37]];

  end;  


export function create_resources;               
  var i;
  begin
    for i:=1 to 16 do
      CreateResourcesArea(mat_cans,5,Pile1,false);
    for i:=1 to 16 do
      CreateResourcesArea(mat_cans,5,Pile2,false);
    for i:=1 to 16 do
      CreateResourcesArea(mat_cans,5,Pile3,false);
  end;

