Starting
begin

     ResetFog;
     Init;

     AnimateTrees(true);

     Randomize;
     RandomizeAll;

     InitRussian;
     InitAction;

     DebugMode;

end;

Export Yakotich, Mietek, Smirnovsky, Kostyliev, Sidorov, Choroszczanow, Stefan;
Export Maxim;
Export Volkovich;

Export Debug;

Export mission_prefix;
Export CaveCheck, HillCheck, RoadCheck, WasInBase, Vehicle_Constructed, All_Techs_Done;

Export Function Init;
Begin

 mission_prefix := '01_';
//Debug := True;
CaveCheck := False;
HillCheck := False;
RoadCheck := False;
WasInBase := False;
Vehicle_Constructed := False;
All_Techs_Done := True;

end;

Function DebugMode;
var i;
begin
     if not debug then
     exit;

     Difficulty := 3;
     TurnFogOff();
     FogOff(3);
end;