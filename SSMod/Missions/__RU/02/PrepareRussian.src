Export Function InitRussian;
var i, tmp;
Begin

     Uc_Side = 6;

     Kurin := PrepareUnit('Kurin', (not debug), '');

     Uc_Side = 3;

     Yakotich := PrepareUnit('Yakotich', (not debug), prevMissionPrefix);
     Mietek := PrepareUnit('Mietek', (not debug), prevMissionPrefix);
     Maxim := PrepareUnit('Maxim', (not debug), prevMissionPrefix);
     Smirnovsky := PrepareUnit('Smirnovsky', (not debug), prevMissionPrefix);
     Kostyliev := PrepareUnit('Kostyliev', (not debug), prevMissionPrefix);

     OtherTeam := CreateCharacterSet(PrevMissionPrefix & 'OtherSurvivors');

     SetClass(Smirnovsky, 4);
     SetCLass(Kostyliev, 3);
     SetClass([Mietek, Yakotich, Maxim], 1);

     //SetClass(OtherTeam, 1);

     PlaceHumanInUnit(Yakotich, RuDepot);
     PlaceHumanInUnit(Mietek, Armoury);
     PlaceHumanInUnit(Maxim, Armoury);
     PlaceHumanInUnit(Kostyliev, Workshop);
     PlaceHumanInUnit(Smirnovsky, Lab);

     for i in OtherTeam do
     begin
          case GetClass(i) of
          class_soldier: tmp := FilterAllUnits([[f_side, 3], [f_not, [f_full]], [f_btype, b_breastwork]]) ^ FilterAllUnits([[f_side, 3], [f_not, [f_full]], [f_btype, b_armoury]]);
          class_scientistic: tmp := FilterAllUnits([[f_side, 3], [f_not, [f_full]], [f_btype, b_lab]]);
          class_mechanic: tmp := FilterAllUnits([[f_side, 3], [f_not, [f_full]], [f_btype, b_workshop]]);
          class_engineer: PlaceUnitXYR(i, 92, 27, 3, false);
     end;

     if tmp then
     begin
          if GetBType(tmp[1]) in [b_breastwork] then
             PlaceUnitInBunker(i, tmp[1])
          else
               PlaceHumanInUnit(i, tmp[1])
     end
          else
          PlaceUnitXYR(i, 92, 27, 3, false)
     end;

     if VehicleCount > 3 then
     VehicleCount = 3;

     for i = 1 to VehicleCount do
     begin
     uc_nation = nation_russian;
     vc_chassis = ru_medium_wheeled;
     vc_control = control_manual;
     vc_engine = engine_combustion;
     vc_fuel_battery = 90;
     vc_weapon = ru_heavy_machine_gun;
     Tanks = CreateVehicle;
     SetDir(Tanks, 2);
     PlaceUnitArea(Tanks, VehArea, False);
     end;

end;