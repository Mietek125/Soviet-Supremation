On BuildingComplete(building) do
begin

     if GetSide(building) = 3 and GetBType(building) = b_lab_half then
     begin
     Say(Smirnovsky, 'DVlad-05-01');
     Say(Yakotich, 'DYak-05-02');
     ChangeMissionObjectives('Ob3');
     end;
end;

On VehicleRecycled(factory, vehicle, side, nation, x, y, direction, chassis, control, motor, weapon) Do
begin

     if not GunDismantled and CanDismantleGun and GetWeapon(weapon) = 3 or GetWeapon(weapon) = 5 or GetWeapon(weapon) = 6 then
     begin
          GunDismantled := True;
          SetTech(tech_gun, 3, state_enabled);
          SetRestrict(b_ext_gun, 3, state_enabled);
     end;

end;

On VehicleConstructed(vehicle, building) Do
begin

     if GetWeapon(vehicle) = 44 then
     begin
          InGameOn;
          CenterOnUnits(vehicle);
          Wait(0$3);
          DialogueOn;
          Say(Tatiana, 'DTat-08-01');
          Say(Yakotich, 'DYak-08-02');
          ChangeMissionObjectives('Ob4a');
          GunBuilt := True;
          DialogueOff;
          InGameOff;
     end;

     if GetWeapon(vehicle) = 51 or GetWeapon(vehicle) = 90 then
     begin
     CargoBuilt := True;
     ChangeMissionObjectives('Ob2a');
     end;
end;

Every 0$1 Trigger FilterAllUnits([[f_side, 3], [f_type, unit_building], [f_btype, b_bunker]]) >= 3 do
begin
     ChangeMissionObjectives('Ob2b');
     BunkerBuilt := True;
end;

On Contact(side1, side2) do
begin

     if GetSide(side1) = 3 and GetSide(side2) = 4 or GetSide(side1) = 4 and GetSide(side2) = 3 or GetSide(side1) = 3 and GetSide(side2) = 1 or GetSide(side1) = 1 and GetSide(side2) = 3 then
     begin
          CenterOnUnits(side2);
          Say(Yakotich, 'DYak-06-01');
    end;
end;