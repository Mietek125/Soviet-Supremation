Export function PrepareDifficulty;
begin
case Difficulty of
     1:
     begin
     UsSoldMinLevel = 1;
     UsSoldMaxLevel = 3;
     end;

     2..3:
     begin
     UsSoldMinLevel = 2;
     UsSoldMaxLevel = 4;
     end;

end;
End;

Export function RepairBuilding(side, building, area);
var buildingsList, i, eng, engineerOkInside, engineerOkOutside;
begin
engineerOkInside = UnitsInside(building);
engineerOkOutside = FilterUnitsInArea(area,[[f_side, side], [f_class, 2], [f_lives, 1000], [f_not, [f_inside]]]);
buildingsList = FilterUnitsInArea(area, [[[f_side, side], [f_type, unit_building], [f_not, [f_lives, 1000]]]]);

if not buildingsList and not FilterAllUnits([[f_side, side], [f_class, 2], [f_lives, 250]]) then
   exit;

if buildingsList and engineerOkInside then
   ComExitBuilding(UnitFilter(engineerOkInside, [f_class, 2]));

if buildingsList and engineerOkOutside then
   ComRepairBuilding(engineerOkOutside, buildingsList[1]);

if buildingsList = 0 and engineerOkOutside then
   ComEnterUnit(engineerOkOutside, building);

eng := FilterUnitsInArea(area, [[f_side, side], [f_class, 2], [f_not, [f_lives, 650]]]);
if eng then
   for i in eng do
   begin
   //32, 23
        ComMoveXY(i, 32, 23);
   end;
End;

Export function CraneRepairBuild(side, repairArea, destroyedBuildings);
var i, dep, crane, craneList, buildingsList;
begin
craneList := FilterAllUnits([[f_side, side], [f_type, unit_vehicle], [f_weapon, us_crane]]);

if not craneList then
   exit;

buildingsList := FilterAllUnits([[[f_side, side], [f_type, unit_building], [f_not, [f_lives, 1000]]]]);

if buildingsList and UnitFilter(craneList, [f_lives, 750]) then
   ComRepairBuilding(UnitFilter(craneList, [f_lives, 750]), buildingsList[1]);

if UnitFilter(craneList, [f_not, [f_lives, 750]]) then
   ComMoveToArea(UnitFilter(craneList, [f_not, [f_lives, 750]]), repairArea);

if craneList and buildingsList = 0 and destroyedBuildings then
   AddComCraneBuild(craneList, destroyedBuildings[1], destroyedBuildings[2], destroyedBuildings[3], destroyedBuildings[4]);

crane := FilterUnitsInArea(repairArea, [[f_side, side], [f_type, unit_vehicle], [f_weapon, us_crane], [f_not, [f_lives, 750]]]);
dep := FilterUnitsInArea(repairArea, [[f_side, side], [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]]);

if crane then
   for i in crane do
       begin
       if dep then
          ComMoveUnit(i, dep);

       AddComRepairVehicleAndReturn(IsDrivenBy(i));
       end;
End;

Export function HealUnitInBase(side, healArea, baseArea, build);
var sciList, sciListOutside, damageUnits, unitsToHeal, tmp;
begin
sciList = FilterAllUnits([[f_side, side], [f_class, 4], [f_nation ,1], [f_lives, 251]]);
sciListOutside = FilterUnitsInArea(baseArea, [[f_side, side], [f_nation, 1], [f_class, 4], [f_ok]]);
damageUnits = FilterUnitsInArea(baseArea, [[f_side, side], [f_type, unit_human], [f_not, [f_class, 3]], [f_not, [f_lives, 750]]]);
unitsToHeal = FilterUnitsInArea(healArea,[[f_side, side], [f_type, unit_human], [f_not, [f_class, 3]], [f_not, [f_lives, 1000]]]);

if not damageUnits and not unitsToHeal and not sciList then
   exit;

if damageUnits and sciList then
   ComMoveToArea(damageUnits, healArea);

if unitsToHeal and sciList then
   ComExitBuilding(sciList);

if unitsToHeal and sciListOutside then
   ComHeal(sciListOutside, unitsToHeal[1]);

if damageUnits = 0 and unitsToHeal = 0 and sciListOutside then
   begin
   tmp := FilterAllUnits([[f_side, side], [f_type, unit_building], [f_btype, b_lab_half]]);
   ComEnterUnit(UnitFilter(sciListOutside, [f_not, [f_hastask]]), tmp[rand(1, tmp)]);
   end;
End;

Export function BuildVehicle(side, fabric, vehCount, weaponTab, engine, control, chassis);
var i;
begin
if FilterAllUnits([[f_side, side], [f_type, unit_vehicle]]) <= vehCount then
   for i := 1 to vehCount do
       AddComConstruct(fabric, chassis, engine, control, weaponTab[Rand(1, weaponTab)]);
End;

Export function DefendDepot(side, build);
var i, j, tmp, bunkers;
begin
tmp := [];
bunkers := FilterAllUnits([[f_side, side], [f_btype, b_bunker]]);

if bunkers then
   for i in bunkers do
       for j in UnitsInside(i) do
           tmp := Replace(tmp, tmp + 1, j);

if tmp then
   begin
   ComExitBuilding(tmp);
   AddComAgressiveMove(tmp, GetX(build), GetY(build));
   end;
End;

Export function EnterBunkerOrBarrack(side, area);
var i, j, soldiersList, turretList, tmp, barrackList, insideUnits;
begin
soldiersList := FilterUnitsInArea(area, [[f_side, side], [f_outside], [f_lives, 700], [f_not, [f_hastask]], [f_or, [f_class, 1], [f_class, 5], [f_class, 8], [f_class, 9]]]);
turretList := FilterUnitsInArea(area, [[f_side, side], [f_or, [f_btype, b_breastwork], [f_btype, b_bunker]], [f_empty], [f_lives, 251]]);
barrackList := FilterUnitsInArea(area, [[f_side, side], [f_or, [f_btype, b_armoury], [f_btype, b_barracks]], [f_lives, 251]]);

if barrackList then
   begin
   if turretList = 0 then
      begin
      if soldiersList then
         ComEnterUnit(soldiersList, barrackList[Rand(1, barrackList)]);
      end
   else
      begin
      for i in barrackList do
          begin
          if not turretList then
             exit;

          insideUnits = UnitsInside(i);

          if insideUnits then
             begin
             tmp := insideUnits[1];
             ComExitBuilding(tmp);
             AddComEnterUnit(tmp, turretList[1]);
             turretList := Delete(turretList, 1);
             end;
          end;
      end;
   end;
End;

Export Function Spawn(units, area);
begin
     PlaceUnitArea(units, area, 1);
end;

Every 0$2 trigger AIEnable do
begin
enable;

RepairBuilding(1, AmDep1, AmNorthBaseArea);
RepairBuilding(4, AmDep2, AmSouthBaseArea);
//craneRepair(1, crane, AmNorthBaseArea, craneParkArea);
CraneRepairBuild(1, AmNorthBaseArea, amDestroyedBuildings);
HealUnitInBase(1, AmNorthHealArea, AmNorthBaseArea, AmLab1);

if IsDying(AmDep1) or GetSide(AmDep1) = 3 then
   DefendDepot(1, AmDep1)
else
    EnterBunkerOrBarrack(1, AmNorthBaseArea);

if IsDying(AmDep2) or GetSide(AmDep2) = 3 then
   DefendDepot(4, AmDep2)
else
    EnterBunkerOrBarrack(4, AmSouthBaseArea);
End;


Every 0$1 trigger not IsInUnit(will) and IsOk(AmDep1) and GetSide(AmDep1) = 1 do
ComEnterUnit(will, AmDep1);

Every 0$2 trigger AIEnable do
begin
enable;

RepairBuilding(1, AmDep1, AmNorthBaseArea);
RepairBuilding(4, AmDep2, AmSouthBaseArea);
//craneRepair(1, crane, AmNorthBaseArea, craneParkArea);
CraneRepairBuild(1, AmNorthBaseArea, amDestroyedBuildings);
HealUnitInBase(1, AmNorthHealArea, AmNorthBaseArea, AmLab1);

if IsDying(AmDep1) or GetSide(AmDep1) = 3 then
   DefendDepot(1, AmDep1)
else
    EnterBunkerOrBarrack(1, AmNorthBaseArea);

if IsDying(AmDep2) or GetSide(AmDep2) = 3 then
   DefendDepot(4, AmDep2)
else
    EnterBunkerOrBarrack(4, AmSouthBaseArea);
End;

Export Function ComRepairVehicleAndReturn(driver);
var vehicle;
begin
if not driver or not IsInUnit(driver) then
   exit;

vehicle := IsInUnit(driver);
SetTaskList(driver, [
   ['\', 0, 0, 0, 0, 0, 0],
   ['E', 0, 0, vehicle, 0, 0, 0]
]);
End;


Every 1 trigger IsSelected(Jarcin) or GetLives(Jarcin) < 1000 do
begin
JarcinExp([1,2,3,4]);
Wait(0$05);
Say(Jarcin,'DJarcin-Secret-01');
TeleportUnit(Jarcin,78,0,300,True);
Wait(0$05);
RemoveUnit(Jarcin);
SaveVariable(1,'SafeJarcin');
SaveCharacters(Jarcin,'Jarcin');
End;

Export Function JarcinExp(q);
var dec, q1;
begin
  dec = SelectiveQuery('JarcinQuery', q);
  case dec of
   1:begin
     AddExperience_NoLimit(Yakotich,1,1000);
     end;
   2:begin
     AddExperience_NoLimit(Yakotich,2,1000);
     end;
   3:begin
     AddExperience_NoLimit(Yakotich,3,1000);
     end;
    4:begin
     AddExperience_NoLimit(Yakotich,4,1000);
     end;
  end;
end;

every 1 trigger AmericansHeld = false AND FilterUnitsInArea(DontGoArea, [[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]) > 0 do
var unit;
begin
    enable;

    for unit in FilterUnitsInArea(DontGoArea, [[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]) do
    begin
        //InGameOn;
    ComMoveXY(unit,95,59);
end;

end;


Export function InitDeadSoldiers;
var i, un1, un2, un3, un4, hexes1, hexes2, hexes3, hexes4;
begin
hexes1 := AreaToList(AmSoldMeat, 0);
hexes2 := AreaToList(AmMechMeat, 0);
hexes3 := [126, 44];
hexes4 := [138, 49];


for i = 1 to 5 do
    begin
    uc_side := 4;
    uc_nation := 1;

    hc_gallery := '';
    hc_name := '';
    PrepareHuman(rand(1,2), class_soldier, 1);
    un1 := CreateHuman;
    SetDir(un1, 0);
    Create_ColdMeat(un1, hexes1[1][i], hexes1[2][i], true);
    end;

for i = 1 to 2 do
    begin
    PrepareHuman(rand(1,2), class_mechanic, 1);
    un2 := CreateHuman;
    SetDir(un2, 0);
    Create_ColdMeat(un2, hexes2[1][i], hexes2[2][i], true);
    end;

for i = 1 to 1 do
    begin
    uc_side := 9;
    uc_nation := 3;
    PrepareHuman(1, class_soldier, 1);
    un3 := CreateHuman;
    SetDir(un3, 0);
    Create_ColdMeat(un3, 126, 44, true);
    end;

for i = 1 to 2 do
    begin
    PrepareHuman(rand(1,2), class_scientistic, 1);
    un4 := CreateHuman;
    SetDir(un4, 1);
    Create_ColdMeat(un4, 138, 49, true);
    end;

End;


Every 0$1 Trigger BaseCaptured do
begin
enable;

if KurinTime then
   begin
   KurinTime := KurinTime - 0$1;
   display_strings := ['#KurinTime', KurinTime];
   end
else
   begin
   display_strings := '';
   disable;
   InGameOn;
   DialogueOn;
   SayEX(Kurin, 'DKurin-09-01', 0, 1, 1, 1);
   SayEX(Kurin, 'DKurin-09-02', 0, 1, 1, 1);
   Say(Yakotich, 'DYak-09-03');
   ChangeMissionObjectives('Ob5');
   AmericansHeld := True;
   InGameOff;
   DialogueOff;
   end;
End;


































