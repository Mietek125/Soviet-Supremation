Every 1$10 + 0$20 trigger PlayerGotControl do
var i, tmp;
begin
enable;

wait(rand(0$1, 0$11));

tmp := [CratesRu1, CratesRu2, CratesRu3];
i := tmp[rand(1, Count(tmp))];

if GetListOfCratesInArea(i) < 5 then
   CreateCratesArea(rand(1, 5), i, true);
End;

Every 1$0 Trigger PlayerGotControl do
var i;
begin

     enable;
     CreateCratesArea(rand(2,5), CratesAm, True);
     CreateCratesArea(rand(2,3), CratesOvs, True);

end;

