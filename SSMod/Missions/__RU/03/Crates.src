Every 4$40 + 3$20 trigger GetResourceArea(cratesForestArea, mat_cans) < 30 do
begin
enable;
CreateCratesArea(rand(1, 5), cratesForestArea, true);
End;

Every 4$40 trigger GetResourceArea(cratesAmericanArea, mat_cans) < 7 do
begin
enable;
CreateCratesArea(rand(1, 5), cratesAmericanArea, true);
End;

Every 0$45 trigger GetResourceArea(cratesSouthArea, mat_cans) < 14 and tick < [24$0, 18$0, 16$0, 12$0][Difficulty] do
begin
enable;
CreateCratesArea(rand(1, 5), cratesSouthArea, true);
End;

Every 0$30 + 0$30 trigger tick < 6$10 do
begin
enable;
CreateCratesXYR(rand(1, 5), 168, 216, 12, true);
End;