On Contact(side1, side2) do
begin

     if GetSide(side1) = 3 and GetSide(side2) = 6 then
     begin

     CenterOnUnits(Mietek);
     DialogueOn;
     Say(Mietek, 'DMietek-AllyAttack');
     YouLost('AllyAttack');
     end;

end;

{on BuildingComplete(un) do
begin

 if GetSide(un) = 6 then b_list := b_list diff b_list[1];

