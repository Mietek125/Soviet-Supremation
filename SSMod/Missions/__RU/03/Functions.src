Every 1 trigger IsSelected(Kvantovy) or GetLives(Kvantovy) < 1000 do
begin
KvantovyExp([1,2,3,4]);
Wait(0$05);
Say(Kvantovy,'DKvantovy-Secret-01');
TeleportUnit(Kvantovy,231,232,300,True);
Wait(0$05);
RemoveUnit(Kvantovy);
SaveVariable(1,'SafeKvantovy');
SaveCharacters(Kvantovy,'Kvantovy');
End;

Export Function KvantovyExp(q);
var dec, q1;
begin
  dec = SelectiveQuery('KvantovyQuery', q);
  case dec of
   1:begin
     AddExperience_NoLimit(Yakotich,1,1500);
     end;
   2:begin
     AddExperience_NoLimit(Yakotich,2,1500);
     end;
   3:begin
     AddExperience_NoLimit(Yakotich,3,1500);
     end;
    4:begin
     AddExperience_NoLimit(Yakotich,4,1500);
     end;
  end;
end;

Export Function SibQuery(q);
var dec, q1;
begin
  dec = SelectiveQuery('SibMineQuery', q);
  case dec of
   1:begin
     exit;
     end;
  end;
end;

Every 1 Trigger not BeenInMine and IsInArea(Yakotich, DontGoArea) do
var x, y;
begin

     enable;
     x = GetX(Yakotich);
     y = GetY(Yakotich);

     DialogueOn;

     Say(Yakotich, 'DYak-border');

     DialogueOff;
     InGameOn;

     ComMoveXY(Yakotich, x+2, y+10);
     Wait(0$3);

     InGameOff;


end;

Every 0$1 Trigger CutsceneOn do
begin
     enable;

     SetLives(FilterAllUnits([[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]), 1000);

     if not CutsceneOn then
     disable;

end;

Every 0$1 Trigger CutsceneOnDepot do
begin
     enable;

     SetLives(FilterAllUnits([[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]), 1000);

     if not CutsceneOnDepot then
     disable;

end;




