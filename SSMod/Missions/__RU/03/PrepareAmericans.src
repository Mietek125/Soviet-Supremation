Export Function InitAmericans;
Begin

     Uc_Side = 4;

     Hc_Name := 'Jeremy Sikorski';
     Hc_Gallery := 'us';
     Hc_Face_Number := 19;
     Hc_Skills := [6,2,4,1];
     Sikorsky := CreateHuman;

     Hc_Name := 'Henry Lynch';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 49;
     Hc_Skills := [6,4,2,3];
     Lynch := CreateHuman;

     Hc_Name := 'Michael Walker';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 48;
     Hc_Skills := [2,2,5,6];
     Walker := CreateHuman;

     Hc_Name := 'Hallie Jilian';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 39;
     Hc_Skills := [3,6,2,4];
     Jillian := CreateHuman;

     Hc_Name := 'Michael Turner';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 62;
     Hc_Skills := [4,6,3,2];
     Turner := CreateHuman;

     Hc_Name := 'Peter McCreery';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 58;
     Hc_Skills := [1,0,2,6];
     McCreery := CreateHuman;


     Gary := NewCharacter('Gary');
     Bobby := NewCharacter('Bobby');
     Cyrus := NewCharacter('Cyrus');

     Uc_Side = 1;

     VanHouten := NewCharacter('VanHouten');

     Hc_Name := 'Steve Holland';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 60;
     Hc_Skills := [3,4,1,0];
     Steve := CreateHuman;

     Hc_Name := 'Naoma Goichman';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 43;
     Hc_Skills := [3,4,2,1];
     Naoma := CreateHuman;

     Hc_Name := 'Magdalene Glance';
     Hc_Gallery := 'SecondCharsGal';
     Hc_Face_Number := 44;
     Hc_Skills := [0,5,3,1];
     Magdalene := CreateHuman;

end;

Export Function InitSikorskyAttack;
var SikorskyCrew;
Begin

     SikorskyCrew := [Gary, Cyrus, Bobby, Lynch, Jillian, Turner, McCreery, Walker];

     PlaceUnitArea(SikorskyCrew, SikorskyCrewSpawn, False);
     ComHold(SikorskyCrew);
     PlaceUnitXY(Sikorsky, 114, 97, False);

     Say(Sikorsky, 'DSik-02-13');
     ComAttackUnit(Sikorsky, b3);
     Say(Dimitri, 'DDim-02-14');
     ComAgressiveMove(SikorskyCrew, 127, 121);

     if GetLives(b3) <= 900 then
     begin

          MineExplosion(111, 116, 1);

          Wait(0$2);

          ComAttackUnit(Sikorsky, NearestUnitToUnit(Sikorsky, FilterAllUnits([[f_side, 3], [f_type, unit_human], [f_class, 1]])));
          AddComAttackUnit(Sikorsky, Ovsyenko);

          Say(Yakotich, 'DYak-02-15');
          Say(Sikorsky, 'DSik-02-16');

          ComExitBuilding([Yakotich, Dimitri, Dragunov, Cholgovsky]);
          AddComAttackUnit([Yakotich, Dimitri], Sikorsky);
          AddComMoveXY(Yakotich, 169, 217);
          AddComMoveXY(Dimitri, 172, 218);
          AddComTurnUnit(Dimitri, Yakotich);
          AddComTurnUnit(Yakotich, Mietek);
     
          AddComEnterUnit(Cholgovsky, transport1);
          AddComTransport(Cholgovsky, Ovsyenko, mat_siberit);
          AddComEnterUnit(Dragunov, transport2);
          AddComTransport(Dragunov, Ovsyenko, mat_siberit);
          AddComMoveXY([Cholgovsky, Dragunov], 146, 207);

     end;

     if GetLives(Sikorsky) <= 800 then
     begin

          SayEffect('D1-smrtsikora');
          SetLives(Sikorsky, 1);

          ComMoveXY(SikorskyCrew, 127, 126);
          Wait(0$5);
          SayNoName(Jillian, 'DFem-02-18');

          MineExplosion(124, 117, 1);
          Wait(0$0.5);
          MineExplosion(122, 122, 1);
          Wait(0$0.3);
          MineExplosion(134, 134, 1);
          Wait(0$0.5);
          MineExplosion(135, 125, 1);
          Wait(0$3);
          SayNoName(Turner, 'DMal-02-19');
          Say(Yakotich, 'DYak-02-20');
          CenterOnXY(169, 217);
          SayEX(Platonov,'DPlat-02-21', 0, 1, 1, 0);
          SayEX(Platonov,'DPlat-02-22', 0, 1, 1, 0);
          SayEX(Platonov,'DPlat-02-23', 0, 1, 1, 0);
          Say(Yakotich, 'DYak-02-24');
          Say(Mietek, 'DMietek-02-25');
          ComTurnUnit(Dimitri, Mietek);
          ComTurnUnit(Mietek, Dimitri);
          Say(Dimitri, 'DDim-02-26');
          Say(Mietek, 'DMietek-02-27');
          ComTurnUnit([Mietek, Dimitri], Yakotich);
          Say(Yakotich, 'DYak-02-28');

          PlayerGotControl := True;

     end;
end;